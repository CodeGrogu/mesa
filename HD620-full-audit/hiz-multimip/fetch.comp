#version 450
layout(local_size_x = 8, local_size_y = 8) in;
layout(set = 0, binding = 0) uniform sampler2D depth_tex;
layout(set = 0, binding = 1, std430) buffer Out { float v[]; } outbuf;
layout(push_constant) uniform PC { int lod; uint w; uint h; uint offset; } pc;
void main() {
    uvec2 c = gl_GlobalInvocationID.xy;
    if (c.x >= pc.w || c.y >= pc.h) return;
    outbuf.v[pc.offset + c.y * pc.w + c.x] = texelFetch(depth_tex, ivec2(c), pc.lod).r;
}
