#version 450
#extension GL_ARB_shader_clock : require
#extension GL_ARB_gpu_shader_fp64 : require
layout(local_size_x = 16) in;
layout(constant_id = 0) const uint ITER = 1;
layout(set = 0, binding = 0) readonly buffer A { float a[]; };
layout(set = 0, binding = 1) readonly buffer B { float b[]; };
layout(set = 0, binding = 2) buffer C { uint c[]; };
void main()
{
   uint i = gl_GlobalInvocationID.x;
   precise double x = double(a[i]), y = double(b[i]), z = double(double(b[i]));
   uvec2 t0 = clock2x32ARB();
   for (uint k = 0; k < ITER; k++) {
      x = fma(x, y, z);
      x = fma(x, y, z);
      x = fma(x, y, z);
      x = fma(x, y, z);
      x = fma(x, y, z);
      x = fma(x, y, z);
      x = fma(x, y, z);
      x = fma(x, y, z);
      x = fma(x, y, z);
      x = fma(x, y, z);
      x = fma(x, y, z);
      x = fma(x, y, z);
      x = fma(x, y, z);
      x = fma(x, y, z);
      x = fma(x, y, z);
      x = fma(x, y, z);
      x = fma(x, y, z);
      x = fma(x, y, z);
      x = fma(x, y, z);
      x = fma(x, y, z);
      x = fma(x, y, z);
      x = fma(x, y, z);
      x = fma(x, y, z);
      x = fma(x, y, z);
      x = fma(x, y, z);
      x = fma(x, y, z);
      x = fma(x, y, z);
      x = fma(x, y, z);
      x = fma(x, y, z);
      x = fma(x, y, z);
      x = fma(x, y, z);
      x = fma(x, y, z);
      x = fma(x, y, z);
      x = fma(x, y, z);
      x = fma(x, y, z);
      x = fma(x, y, z);
      x = fma(x, y, z);
      x = fma(x, y, z);
      x = fma(x, y, z);
      x = fma(x, y, z);
      x = fma(x, y, z);
      x = fma(x, y, z);
      x = fma(x, y, z);
      x = fma(x, y, z);
      x = fma(x, y, z);
      x = fma(x, y, z);
      x = fma(x, y, z);
      x = fma(x, y, z);
   }
   uvec2 t1 = clock2x32ARB();
   c[i] = t1.x - t0.x;
   c[i + 64] = floatBitsToUint(float(x));
}
