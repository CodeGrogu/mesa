#version 450
layout(local_size_x = 64) in;
layout(constant_id = 0) const uint ITER = 1;
layout(set = 0, binding = 0) readonly buffer A { vec4 a[]; };
layout(set = 0, binding = 1) readonly buffer B { vec4 b[]; };
layout(set = 0, binding = 2) buffer C { float c[]; };
void main()
{
   uint i = gl_GlobalInvocationID.x;
   vec4 x = a[i], y = b[i], z = a[i + 64], w = b[i + 64];
   c[i] = dot(x, y) + dot(z, w);
}
