#version 450
// Convolution-style accumulation followed by leaky ReLU, vec4 FP16 lanes.
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#extension GL_EXT_shader_16bit_storage : require
layout(local_size_x = 128) in;
layout(std430, binding = 0) readonly buffer A { f16vec4 a[]; };
layout(std430, binding = 1) readonly buffer B { f16vec4 b[]; };
layout(std430, binding = 2) readonly buffer C { f16vec4 c[]; };
layout(std430, binding = 3) writeonly buffer O { f16vec4 o[]; };
void main()
{
    uint i = gl_GlobalInvocationID.x;
    f16vec4 sum = c[i];
    for (int k = 0; k < 4; k++)
        sum = fma(a[i * 4 + k], b[k], sum);
    o[i] = mix(sum, sum * float16_t(0.1), lessThan(sum, f16vec4(0)));
}
