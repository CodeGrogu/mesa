#version 450
// Large dynamically indexed private array: forces scratch memory.
layout(local_size_x = 64) in;
layout(std430, binding = 0) buffer B { uint v[]; };

void main()
{
    uint priv[4096];
    uint i = gl_GlobalInvocationID.x;
    for (uint k = 0; k < 4096u; k++)
        priv[k] = k * 2654435761u + i;
    uint acc = 0;
    for (uint k = 0; k < 64u; k++)
        acc += priv[(v[i] + k * 97u) & 4095u];
    v[i] = acc;
}
